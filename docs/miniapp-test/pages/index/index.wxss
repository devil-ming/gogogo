page {
  background: #f5f5f5;
}

.container {
  padding: 30rpx 24rpx 60rpx;
}

/* 标题区 */
.header {
  padding: 20rpx 0 30rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #222;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 状态栏 */
.status-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-label {
  font-size: 24rpx;
  color: #999;
}

.status-value {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.status-value.mock {
  color: #07c160;
}

.status-value.normal {
  color: #fa5151;
}

/* 刷新按钮 */
.refresh-btn {
  width: 100%;
  margin-bottom: 30rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* 各卡片左侧强调色 */
.wgs84-card {
  border-left: 6rpx solid #1989fa;
}

.gcj02-card {
  border-left: 6rpx solid #00796b;
}

.address-card {
  border-left: 6rpx solid #ff9800;
}

.watch-card {
  border-left: 6rpx solid #9c27b0;
}

.card-header {
  padding: 24rpx 24rpx 12rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.card-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.card-body {
  padding: 12rpx 24rpx 24rpx;
}

.card-footer {
  padding: 0 24rpx 24rpx;
}

/* 坐标行 */
.coord-row,
.address-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.coord-row:last-child,
.address-row:last-child {
  border-bottom: none;
}

.coord-label,
.address-label {
  font-size: 26rpx;
  color: #888;
  flex-shrink: 0;
}

.coord-value,
.address-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

/* 复制按钮 */
.copy-btn {
  width: 100%;
}

.copy-all-btn {
  width: 100%;
  margin: 10rpx 0 30rpx;
}

/* 说明 */
.tips {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  color: #888;
  line-height: 1.8;
}

/* 页脚 */
.footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
